PORT=5100
DATABASE_URL=

# Email (Resend) -- notifies the owner inbox whenever the contact form
# (routes/contact.js) is submitted. pluggpress.com must be a verified
# sending domain in the Resend dashboard.
RESEND_API_KEY=re_your_resend_api_key_here
# Address contact notification emails are sent from/as.
CONTACT_FROM_EMAIL=contact@pluggpress.com
# Inbox that receives the notification. Falls back to CONTACT_FROM_EMAIL if unset.
OWNER_EMAIL=contact@pluggpress.com
