PORT=5100
DATABASE_URL=

# Admin auth (JWT signing secret for /api/auth and the admin panel)
JWT_SECRET=change_this_to_a_long_random_string

# Google Analytics (GA4) for the admin dashboard's traffic stats.
# GOOGLE_SERVICE_ACCOUNT_KEY is the full JSON key for a service account with
# Viewer access on the GA4 property, as a single-line JSON string.
# GA_PROPERTY_ID is that property's numeric ID (GA Admin > Property Settings).
GOOGLE_SERVICE_ACCOUNT_KEY=
GA_PROPERTY_ID=

# Email (notifies the owner inbox whenever the contact form in
# routes/contact.js is submitted) -- nodemailer via Namecheap Private
# Email's SMTP (mail.privateemail.com:587, hardcoded in utils/email.js).
EMAIL_USER=contact@pluggpress.com
EMAIL_PASSWORD=your_mailbox_password_here
OWNER_EMAIL=contact@pluggpress.com
